    {
      "label": "(a) 沒有狀態檔：說裝好了也放行",
      "setup": {
        "transcript": [
          {
            "type": "user",
            "message": {
              "role": "user",
              "content": "/harness:init"
            }
          },
          {
            "type": "assistant",
            "message": {
              "role": "assistant",
              "content": [
                {
                  "type": "text",
                  "text": "harness 安裝完成，以下是收尾回報"
                }
              ]
            }
          }
        ]
      },
      "payload": {
        "hook_event_name": "Stop",
        "stop_hook_active": false
      },
      "expect": "SILENT"
    },
    {
      "label": "(b) 訪談中一般的回合結束（問完一題等回答）放行",
