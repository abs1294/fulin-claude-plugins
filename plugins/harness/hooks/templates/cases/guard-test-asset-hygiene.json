{
  "hook": "guard-test-asset-hygiene.js",
  "variants": {
    "demo": {
      "replace": [
        [
          "const CHECKERS = [];",
          "const CHECKERS = [\n  {\n    \"name\": \"hardcoded-data\",\n    \"cmd\": \"node -e \\\"process.exit(require('fs').readFileSync(process.argv[1],'utf8').includes('HARDCODED')?1:0)\\\" {file}\",\n    \"fix\": \"改走產品入口造資料，不要寫死。\"\n  }\n];"
        ]
      ]
    },
    "slow-tool": {
      "replace": [
        [
          "const CHECKERS = [];",
          "const CHECKERS = [{ name: \"slow\", cmd: \"node -e \\\"setTimeout(function(){}, 5000)\\\" {file}\" }];"
        ],
        [
          "const CHECK_TIMEOUT_MS = 90000;",
          "const CHECK_TIMEOUT_MS = 300;"
        ]
      ]
    },
    "warn-only": {
      "replace": [
        [
          "const CHECKERS = [];",
          "const CHECKERS = [\n  {\n    \"name\": \"fixture-names\",\n    \"cmd\": \"node -e \\\"process.exit(require('fs').readFileSync(process.argv[1],'utf8').includes('TODO_DATA')?1:0)\\\" {file}\",\n    \"fix\": \"改走產品入口造資料，不要寫死。\",\n    \"level\": \"warn\"\n  }\n];"
        ]
      ]
    },
    "mixed": {
      "replace": [
        [
          "const CHECKERS = [];",
          "const CHECKERS = [\n  {\n    \"name\": \"hardcoded-data\",\n    \"cmd\": \"node -e \\\"process.exit(require('fs').readFileSync(process.argv[1],'utf8').includes('HARDCODED')?1:0)\\\" {file}\",\n    \"fix\": \"改走產品入口造資料，不要寫死。\"\n  },\n  {\n    \"name\": \"fixture-names\",\n    \"cmd\": \"node -e \\\"process.exit(require('fs').readFileSync(process.argv[1],'utf8').includes('TODO_DATA')?1:0)\\\" {file}\",\n    \"fix\": \"改走產品入口造資料，不要寫死。\",\n    \"level\": \"warn\"\n  }\n];"
        ]
      ]
    },
    "bad-level": {
      "replace": [
        [
          "const CHECKERS = [];",
          "const CHECKERS = [\n  {\n    \"name\": \"hardcoded-data\",\n    \"cmd\": \"node -e \\\"process.exit(require('fs').readFileSync(process.argv[1],'utf8').includes('HARDCODED')?1:0)\\\" {file}\",\n    \"fix\": \"改走產品入口造資料，不要寫死。\",\n    \"level\": \"soft\"\n  }\n];"
        ]
      ]
    }
  },
  "cases": [
