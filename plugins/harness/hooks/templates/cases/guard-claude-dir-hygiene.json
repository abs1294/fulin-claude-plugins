{
  "hook": "guard-claude-dir-hygiene.js",
  "cases": [
    {
      "label": "白名單目錄內新建 hook → 放行",
      "setup": {},
      "payload": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": { "file_path": ".claude/hooks/new-hook.js" }
      },
      "expect": "ALLOW"
    },
    {
      "label": ".claude/ 根下新建隨手報告檔 → 擋下",
      "setup": {},
      "payload": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": { "file_path": ".claude/report.md" }
      },
      "expect": "BLOCK"
    },
    {
      "label": "非白名單子目錄新建一次性設計文件 → 擋下",
      "setup": {},
      "payload": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": { "file_path": ".claude/design-notes/feature-x-plan.md" }
      },
      "expect": "BLOCK"
    },
    {
      "label": "覆寫已存在的檔（Write 到既有檔）→ 放行",
      "setup": {
        "files": {
          ".claude/legacy-notes/old.md": "既有內容\n"
        }
      },
      "payload": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": { "file_path": ".claude/legacy-notes/old.md" }
      },
      "expect": "ALLOW"
    },
    {
      "label": ".claude/ 以外的一般專案檔 → 放行",
      "setup": {},
      "payload": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": { "file_path": "src/feature.js" }
      },
      "expect": "ALLOW"
    },
    {
      "label": "Edit 既有檔（非 Write 工具）→ 不受本閘管轄",
      "setup": {
        "files": {
          ".claude/notes/old.md": "既有內容\n"
        }
      },
      "payload": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Edit",
        "tool_input": { "file_path": ".claude/notes/old.md" }
      },
      "expect": "ALLOW"
    },
    {
      "label": ".claude/ 根層新建允許清單內的檔（settings.local.json）→ 放行",
      "setup": {},
      "payload": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": { "file_path": ".claude/settings.local.json" }
      },
      "expect": "ALLOW"
    },
    {
      "label": ".claude/ 根層新建 git-commit 的設定檔（qa-gate.conf）→ 放行（init 要建它）",
      "setup": {},
      "payload": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": ".claude/qa-gate.conf"
        }
      },
      "expect": "ALLOW"
    },
    {
      "label": ".claude/ 根層新建 git-commit 的設定檔（git-commit-reviewer-addendum.md）→ 放行（init 要建它）",
      "setup": {},
      "payload": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": ".claude/git-commit-reviewer-addendum.md"
        }
      },
      "expect": "ALLOW"
    },
    {
      "label": "session 在子目錄（cwd＝<根>/sub）、沒設 CLAUDE_PROJECT_DIR，絕對路徑寫 <根>/.claude/report-x.md → 擋下（專案根要退回 hook 所在位置，不是 cwd）",
      "setup": {
        "files": { "sub/.keep": "" },
        "env": { "CLAUDE_PROJECT_DIR": null }
      },
      "payload": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "cwd": "{PROJECT_DIR}/sub",
        "tool_input": { "file_path": "{PROJECT_DIR}/.claude/report-x.md" }
      },
      "expect": "BLOCK"
    },
    {
      "label": "session 在子目錄、沒設 CLAUDE_PROJECT_DIR，相對路徑 ../.claude/report-y.md → 擋下",
      "setup": {
        "files": { "sub/.keep": "" },
        "env": { "CLAUDE_PROJECT_DIR": null }
      },
      "payload": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "cwd": "{PROJECT_DIR}/sub",
        "tool_input": { "file_path": "../.claude/report-y.md" }
      },
      "expect": "BLOCK"
    },
    {
      "label": "相對路徑以 payload cwd 為基準判存在：<根>/sub/.claude/legacy/old.md 已存在、cwd＝sub → 放行（覆寫既有檔）",
      "setup": {
        "files": { "sub/.claude/legacy/old.md": "既有內容\n" }
      },
      "payload": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "cwd": "{PROJECT_DIR}/sub",
        "tool_input": { "file_path": ".claude/legacy/old.md" }
      },
      "expect": "ALLOW"
    },
    {
      "label": "相對路徑以 payload cwd 為基準判存在：只有 <根>/.claude/legacy/x.md 存在、cwd＝sub 寫 .claude/legacy/x.md 是新建 → 擋下",
      "setup": {
        "files": { "sub/.keep": "", ".claude/legacy/x.md": "根目錄那份\n" }
      },
      "payload": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "cwd": "{PROJECT_DIR}/sub",
        "tool_input": { "file_path": ".claude/legacy/x.md" }
      },
      "expect": "BLOCK"
    }
  ]
}
