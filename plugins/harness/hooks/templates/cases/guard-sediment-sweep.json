    {
      "label": "stop 模式：擋過一次仍缺（防無限迴圈）",
      "variant": "stop",
      "setup": {
        "transcript": [
          {
            "type": "user",
            "message": {
              "role": "user",
              "content": "改"
            }
          },
          {
            "type": "assistant",
            "message": {
              "role": "assistant",
              "content": [
                {
                  "type": "tool_use",
                  "id": "x",
                  "name": "Edit",
                  "input": {
                    "file_path": "src/add.js"
                  }
                }
              ]
            }
          },
          {
            "type": "user",
            "message": {
              "role": "user",
              "content": [
                {
                  "type": "tool_result",
                  "tool_use_id": "x",
                  "content": "ok"
                }
              ]
            }
          },
          {
            "type": "assistant",
            "message": {
              "role": "assistant",
              "content": [
                {
                  "type": "text",
                  "text": "好"
                }
              ]
            }
          }
        ]
