{
  "hook": "guard-test-preconditions.js",
  "variants": {
    "demo": {
      "replace": [
        [
          "const CHECKS = [];",
          "const CHECKS = [\n  {\n    \"id\": \"mail-sink\",\n    \"kind\": \"file\",\n    \"path\": \"config/mail.test.json\",\n    \"mustMatch\": \"\\\"host\\\"\\\\s*:\\\\s*\\\"(localhost|127\\\\.0\\\\.0\\\\.1)\\\"\",\n    \"mustNotMatch\": \"\\\"cc\\\"\\\\s*:\\\\s*\\\\[\\\\s*\\\"\",\n    \"reason\": \"測試會寄信；SMTP 不是本機收信器就會寄給真人。\",\n    \"fix\": \"把 SMTP 指回 localhost、清空 cc。\"\n  },\n  {\n    \"id\": \"api-base\",\n    \"kind\": \"env\",\n    \"env\": \"TEST_API_BASE\",\n    \"matches\": \"^https?://localhost:\\\\d+\",\n    \"reason\": \"測試要打自己起的那套服務。\",\n    \"fix\": \"source 這套服務自己的環境檔再跑。\"\n  },\n  {\n    \"id\": \"api-db\",\n    \"kind\": \"env\",\n    \"env\": \"DATABASE_URL\",\n    \"when\": \"(^|[\\\\s/\\\\\\\\])api\\\\b|\\\\bnode\\\\b[^\\\\n]*\\\\s--test\\\\b\",\n    \"matches\": \"^postgres(ql)?://(localhost|127\\\\.0\\\\.0\\\\.1)\",\n    \"reason\": \"api 的測試會寫資料庫，必須指向本機測試庫。\",\n    \"fix\": \"用 api 自己的 .env.test 再跑。\"\n  }\n];"
        ]
      ]
    },
    "scoped": {
      "replace": [
        [
          "const CHECKS = [];",
          "const CHECKS = [\n  {\n    \"id\": \"api-db\",\n    \"kind\": \"env\",\n    \"env\": \"DATABASE_URL\",\n    \"when\": \"\\\\bapi\\\\b\",\n    \"matches\": \"^postgres(ql)?://(localhost|127\\\\.0\\\\.0\\\\.1)\",\n    \"reason\": \"api 的測試會寫資料庫。\",\n    \"fix\": \"帶 api 的 .env.test 再跑。\"\n  }\n];"
        ]
      ]
    },
    "envonly": {
      "replace": [
        [
          "const CHECKS = [];",
          "const CHECKS = [\n{\n  \"id\": \"api-base\",\n  \"kind\": \"env\",\n  \"env\": \"TEST_API_BASE\",\n  \"matches\": \"^https?://localhost:\\\\d+\",\n  \"reason\": \"測試要打自己起的那套服務。\",\n  \"fix\": \"TEST_API_BASE=http://localhost:3000 npm test\"\n}\n];"
        ]
      ]
    },
    "within": {
      "replace": [
        [
          "const CHECKS = [];",
          "const CHECKS = [\n{\n  \"id\": \"mail-sink-block\",\n  \"kind\": \"file\",\n  \"path\": \"config/app.ini\",\n  \"within\": \"^\\\\[test\\\\][^\\\\[]*\",\n  \"mustMatch\": \"^mail_sink\\\\s*=\\\\s*on\",\n  \"reason\": \"測試區塊沒收斂寄信會寄給真人。\",\n  \"fix\": \"在 config/app.ini 的 [test] 區塊加 mail_sink = on\"\n}\n];"
        ]
      ]
    }
  },
  "cases": [
    {
      "label": "預設空檢查表：跑測試放行",
      "setup": {
        "files": {
          "config/mail.test.json": "{ \"host\": \"smtp.example.com\", \"port\": 587, \"cc\": [\"team@example.com\"] }\n"
        },
        "env": {
          "TEST_API_BASE": null
        }
      },
      "payload": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "npm test"
        }
      },
      "expect": "ALLOW"
