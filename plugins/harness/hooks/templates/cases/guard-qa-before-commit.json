{
  "hook": "guard-qa-before-commit.js",
  "cases": [
    {
      "label": "staged 行為類檔、沒表態 QA",
      "setup": {
        "files": {
          "src/add.js": "export const add = (a, b) => a + b;\n",
          "README.md": "# x\n",
          "tests/add.test.js": "require(\"node:test\")\n"
        },
        "stage": [
          "src/add.js"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "BLOCK"
    },
    {
      "label": "帶 --qa-verified",
      "setup": {
        "files": {
          "src/add.js": "export const add = (a, b) => a + b;\n",
          "README.md": "# x\n",
          "tests/add.test.js": "require(\"node:test\")\n"
        },
        "stage": [
          "src/add.js"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit",
          "args": "--qa-verified"
        }
      },
      "expect": "ALLOW"
    },
    {
      "label": "帶 --no-qa（分流例外）",
      "setup": {
        "files": {
          "src/add.js": "export const add = (a, b) => a + b;\n",
          "README.md": "# x\n",
          "tests/add.test.js": "require(\"node:test\")\n"
        },
        "stage": [
          "src/add.js"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit",
          "args": "--no-qa 純文案"
        }
      },
      "expect": "ALLOW"
    },
    {
      "label": "只 staged 文件",
      "setup": {
        "files": {
          "src/add.js": "export const add = (a, b) => a + b;\n",
          "README.md": "# x\n",
          "tests/add.test.js": "require(\"node:test\")\n"
        },
        "stage": [
          "README.md"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "ALLOW"
    },
    {
      "label": "只 staged 測試檔",
      "setup": {
        "files": {
          "src/add.js": "export const add = (a, b) => a + b;\n",
          "README.md": "# x\n",
          "tests/add.test.js": "require(\"node:test\")\n"
        },
        "stage": [
          "tests/add.test.js"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "ALLOW"
    },
    {
      "label": "別的 skill 不管",
      "setup": {
        "files": {
          "src/add.js": "export const add = (a, b) => a + b;\n",
          "README.md": "# x\n",
          "tests/add.test.js": "require(\"node:test\")\n"
        },
        "stage": [
          "src/add.js"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "simplify"
        }
      },
      "expect": "ALLOW"
    },
    {
      "label": "覆寫夾帶（開）：Skill 入口，analyze 印出 [STAGED, in overrides]，即使帶 --qa-verified 也擋",
      "setup": {
        "files": {
          "src/add.js": "export const add = (a, b) => a + b;\n",
          "README.md": "# x\n",
          "tests/add.test.js": "require(\"node:test\")\n",
          "conf.txt": "a=1\n",
          ".claude/skills/git-commit/flow.sh": "#!/bin/bash\necho \"=== REPO: $2 ===\"\necho \"--- Excluded by local-overrides (1) ---\"\necho \"conf.txt [STAGED, in overrides]\"\n"
        },
        "stage": [
          "src/add.js",
          "conf.txt"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit",
          "args": "--qa-verified"
        }
      },
      "expect": "BLOCK",
      "variant": "overrides-on"
    },
    {
      "label": "覆寫夾帶（開）：Skill 入口帶 --allow-overrides --qa-verified → 放行",
      "setup": {
        "files": {
          "src/add.js": "export const add = (a, b) => a + b;\n",
          "README.md": "# x\n",
          "tests/add.test.js": "require(\"node:test\")\n",
          "conf.txt": "a=1\n",
          ".claude/skills/git-commit/flow.sh": "#!/bin/bash\necho \"=== REPO: $2 ===\"\necho \"--- Excluded by local-overrides (1) ---\"\necho \"conf.txt [STAGED, in overrides]\"\n"
        },
        "stage": [
          "src/add.js",
          "conf.txt"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit",
          "args": "--qa-verified --allow-overrides"
        }
      },
      "expect": "ALLOW",
      "variant": "overrides-on"
    },
    {
      "label": "覆寫夾帶（開）：analyze 沒有標記 → 只剩 QA 表態檢查，帶 --qa-verified 放行",
      "setup": {
        "files": {
          "src/add.js": "export const add = (a, b) => a + b;\n",
          "README.md": "# x\n",
          "tests/add.test.js": "require(\"node:test\")\n",
          "conf.txt": "a=1\n",
          ".claude/skills/git-commit/flow.sh": "#!/bin/bash\necho \"=== REPO: $2 ===\"\necho \"--- Excluded by local-overrides (0) ---\"\necho \"(none)\"\n"
        },
        "stage": [
          "src/add.js",
          "conf.txt"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit",
          "args": "--qa-verified"
        }
      },
      "expect": "ALLOW",
      "variant": "overrides-on"
    },
    {
      "label": "覆寫夾帶（關，預設）：analyze 會印標記也不跑這項 → 帶 --qa-verified 放行",
      "setup": {
        "files": {
          "src/add.js": "export const add = (a, b) => a + b;\n",
          "README.md": "# x\n",
          "tests/add.test.js": "require(\"node:test\")\n",
          "conf.txt": "a=1\n",
          ".claude/skills/git-commit/flow.sh": "#!/bin/bash\necho \"=== REPO: $2 ===\"\necho \"--- Excluded by local-overrides (1) ---\"\necho \"conf.txt [STAGED, in overrides]\"\n"
        },
        "stage": [
          "src/add.js",
          "conf.txt"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit",
          "args": "--qa-verified"
        }
      },
      "expect": "ALLOW"
    },
    {
      "label": "覆寫夾帶（開）：FLOW_SH 填錯找不到 → 這項放行但要用 additionalContext 提醒模型（fail-open 要 loud，純文字模型看不到）",
      "setup": {
        "files": {
          "src/add.js": "export const add = (a, b) => a + b;\n",
          "README.md": "# x\n",
          "tests/add.test.js": "require(\"node:test\")\n",
          "conf.txt": "a=1\n",
          ".claude/skills/git-commit/flow.sh": "#!/bin/bash\necho \"=== REPO: $2 ===\"\necho \"--- Excluded by local-overrides (1) ---\"\necho \"conf.txt [STAGED, in overrides]\"\n"
        },
        "stage": [
          "src/add.js",
          "conf.txt"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit",
          "args": "--qa-verified"
        }
      },
      "expect": "NOTE",
      "variant": "overrides-on-bad-path",
      "visible": true
    },
    {
      "label": "Bash 入口已不判斷：flow.sh review-record 沒帶 --qa、staged 有行為類檔 → hook 不攔也不出聲（權威檢查在 flow.sh＋.claude/qa-gate.conf）",
      "setup": {
        "files": {
          "src/add.js": "export const add = (a, b) => a + b;\n",
          "README.md": "# x\n",
          "tests/add.test.js": "require(\"node:test\")\n"
        },
        "stage": [
          "src/add.js"
        ]
      },
      "payload": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "bash ~/.claude/plugins/cache/m/git-commit/1.0.0/skills/git-commit/flow.sh review-record . --codex \"VERDICT: PASS\" --reviewer \"VERDICT: PASS\""
        }
      },
      "expect": "SILENT"
    },
    {
      "label": "Bash 入口已不判斷：flow.sh review-record 帶 --qa → 同樣不攔也不出聲",
      "setup": {
        "files": {
          "src/add.js": "export const add = (a, b) => a + b;\n",
          "README.md": "# x\n",
          "tests/add.test.js": "require(\"node:test\")\n"
        },
        "stage": [
          "src/add.js"
        ]
      },
      "payload": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "bash ~/.claude/plugins/cache/m/git-commit/1.0.0/skills/git-commit/flow.sh review-record . --codex \"PASS\" --reviewer \"PASS\" --qa \"已QA：tests/add.test.js 實跑 3 passed\""
        }
      },
      "expect": "SILENT"
    },
    {
      "label": "qa-gate.conf 判準：有 qa-gate.conf、behavior_ext 只有 .vue，staged src/add.js → 以 conf 為準不算行為類（舊版照填空區會擋）",
      "setup": {
        "files": {
          ".claude/qa-gate.conf": "behavior_ext=.vue\nexclude=^tests?/\n",
          "src/add.js": "x\n"
        },
        "stage": [
          "src/add.js"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "SILENT"
    },
    {
      "label": "qa-gate.conf 判準：有 qa-gate.conf、behavior_ext 有 .vue，staged src/App.vue → 擋（填空區沒有 vue，舊版會放行）",
      "setup": {
        "files": {
          ".claude/qa-gate.conf": "behavior_ext=.vue\nexclude=^tests?/\n",
          "src/App.vue": "<template/>\n"
        },
        "stage": [
          "src/App.vue"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "BLOCK"
    },
    {
      "label": "qa-gate.conf 判準：有 qa-gate.conf、exclude 有 ^legacy/，staged legacy/a.js → 以 conf 為準排除（舊版會擋）",
      "setup": {
        "files": {
          ".claude/qa-gate.conf": "behavior_ext=.js\nexclude=^legacy/\n",
          "legacy/a.js": "x\n"
        },
        "stage": [
          "legacy/a.js"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "SILENT"
    },
    {
      "label": "qa-gate.conf 判準：init 預設 conf（exclude 用字元類寫不分大小寫），staged src/a.Spec.js → 排除、放行",
      "setup": {
        "files": {
          ".claude/qa-gate.conf": "behavior_ext=.js .ts .vue\nexclude=^tests?/ (^|/)__tests__/ \\.([Tt][Ee][Ss][Tt]|[Ss][Pp][Ee][Cc])\\.[A-Za-z]+$\nblock_staged_overrides=0\n",
          "src/a.Spec.js": "x\n"
        },
        "stage": [
          "src/a.Spec.js"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "SILENT"
    },
    {
      "label": "qa-gate.conf 判準：conf 的 exclude 區分大小寫（同 flow.sh），exclude 寫 \\.spec\\.js$、staged src/a.Spec.js → 不排除、擋（舊版填空區 /i 會放行）",
      "setup": {
        "files": {
          ".claude/qa-gate.conf": "behavior_ext=.js\nexclude=\\.spec\\.js$\n",
          "src/a.Spec.js": "x\n"
        },
        "stage": [
          "src/a.Spec.js"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "BLOCK"
    },
    {
      "label": "qa-gate.conf 判準：conf 的 behavior_ext 比對不分大小寫（同 flow.sh），staged src/A.VUE → 擋",
      "setup": {
        "files": {
          ".claude/qa-gate.conf": "behavior_ext=.vue\n",
          "src/A.VUE": "x\n"
        },
        "stage": [
          "src/A.VUE"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "BLOCK"
    },
    {
      "label": "qa-gate.conf 判準：conf 用 POSIX 字元類 [[:alpha:]] 與 [] 開頭的字面 ]，staged gen/abc/x.js → 排除、放行",
      "setup": {
        "files": {
          ".claude/qa-gate.conf": "behavior_ext=.js\nexclude=^gen/[[:alpha:]]+/ ^[]]x/\n",
          "gen/abc/x.js": "x\n"
        },
        "stage": [
          "gen/abc/x.js"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "SILENT"
    },
    {
      "label": "qa-gate.conf 判準：conf 有 BOM、CRLF、整行註解與行尾註解，staged src/App.vue → 認得 behavior_ext、擋",
      "setup": {
        "files": {
          ".claude/qa-gate.conf": "﻿# 給 flow.sh 讀的 QA 閘設定\r\nbehavior_ext=.vue   # 前端單檔元件\r\nexclude=^legacy/\r\n",
          "src/App.vue": "x\n"
        },
        "stage": [
          "src/App.vue"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "BLOCK"
    },
    {
      "label": "qa-gate.conf 判準：conf 有 BOM、CRLF、行尾註解，staged legacy/x.vue → exclude 生效、放行",
      "setup": {
        "files": {
          ".claude/qa-gate.conf": "﻿# 給 flow.sh 讀的 QA 閘設定\r\nbehavior_ext=.vue   # 前端單檔元件\r\nexclude=^legacy/\r\n",
          "legacy/x.vue": "x\n"
        },
        "stage": [
          "legacy/x.vue"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "SILENT"
    },
    {
      "label": "qa-gate.conf 判準：conf 沒寫 behavior_ext（flow.sh 視為不做 QA 檢查），staged src/add.js → 同 flow.sh 不擋（舊版會擋）",
      "setup": {
        "files": {
          ".claude/qa-gate.conf": "block_staged_overrides=0\n",
          "src/add.js": "x\n"
        },
        "stage": [
          "src/add.js"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "SILENT"
    },
    {
      "label": "qa-gate.conf 判準：conf 放在子 repo 的上一層（專案根 .claude/），多 repo 時從 repo 目錄往上找得到 → 以 conf 為準",
      "setup": {
        "files": {
          ".claude/qa-gate.conf": "behavior_ext=.vue\n"
        },
        "repos": {
          "svc": {
            "files": {
              "src/App.vue": "x\n"
            },
            "stage": [
              "src/App.vue"
            ]
          }
        }
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "BLOCK",
      "variant": "multi-repo-svc"
    },
    {
      "label": "qa-gate.conf 判準：沒有 qa-gate.conf，staged src/App.vue → 退回填空區（沒有 vue）放行",
      "setup": {
        "files": {
          "src/App.vue": "x\n"
        },
        "stage": [
          "src/App.vue"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "SILENT"
    },
    {
      "label": "qa-gate.conf 判準：沒有 qa-gate.conf，staged src/add.js → 退回填空區擋",
      "setup": {
        "files": {
          "src/add.js": "x\n"
        },
        "stage": [
          "src/add.js"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "BLOCK"
    },
    {
      "label": "qa-gate.conf 判準：conf 的 exclude 括號不成對（寫壞），staged tests/add.test.js → 退回填空區（排除測試檔）放行，並用 additionalContext 提醒",
      "setup": {
        "files": {
          ".claude/qa-gate.conf": "behavior_ext=.js\nexclude=(tests\n",
          "tests/add.test.js": "x\n"
        },
        "stage": [
          "tests/add.test.js"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "NOTE",
      "visible": true
    },
    {
      "label": "qa-gate.conf 判準：conf 的 exclude 括號不成對（寫壞），staged src/add.js → 退回填空區照擋（提醒併進擋下訊息）",
      "setup": {
        "files": {
          ".claude/qa-gate.conf": "behavior_ext=.js\nexclude=(tests\n",
          "src/add.js": "x\n"
        },
        "stage": [
          "src/add.js"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "BLOCK"
    },
    {
      "label": "qa-gate.conf 判準：conf 的 exclude 用 JS 才有的 \\d（ERE 沒有），staged legacy/a.js → 不猜、退回填空區並提醒（填空區不排除 legacy → 擋）",
      "setup": {
        "files": {
          ".claude/qa-gate.conf": "behavior_ext=.js\nexclude=^v\\d/\n",
          "legacy/a.js": "x\n"
        },
        "stage": [
          "legacy/a.js"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "BLOCK"
    },
    {
      "label": "qa-gate.conf 判準：conf 的 exclude 用 JS 的 (?:…)（ERE 沒有），只 staged 文件 → 放行，但用 additionalContext 提醒 conf 翻不了",
      "setup": {
        "files": {
          ".claude/qa-gate.conf": "behavior_ext=.js\nexclude=^(?:gen)/\n",
          "README.md": "# x\n"
        },
        "stage": [
          "README.md"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "NOTE",
      "visible": true
    },
    {
      "label": "中文與含空白檔名：沒有 conf、staged 中文檔名 src/計算.js → 擋（舊版 git 把檔名包成 \"src/\\350…\" 而判成不是行為類）",
      "setup": {
        "files": {
          "src/計算.js": "x\n"
        },
        "stage": [
          "src/計算.js"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "BLOCK"
    },
    {
      "label": "中文與含空白檔名：conf 只列 .vue、staged 含空白與中文的 src/頁 面.vue → 擋",
      "setup": {
        "files": {
          ".claude/qa-gate.conf": "behavior_ext=.vue\n",
          "src/頁 面.vue": "x\n"
        },
        "stage": [
          "src/頁 面.vue"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "BLOCK"
    },
    {
      "label": "中文與含空白檔名：中文檔名的測試檔 tests/計算.test.js → 照填空區排除、不出聲",
      "setup": {
        "files": {
          "tests/計算.test.js": "x\n"
        },
        "stage": [
          "tests/計算.test.js"
        ]
      },
      "payload": {
        "tool_name": "Skill",
        "tool_input": {
          "skill": "git-commit"
        }
      },
      "expect": "SILENT"
    }
  ],
  "variants": {
    "overrides-on": {
      "replace": [
        [
          "const CHECK_OVERRIDES = false;",
          "const CHECK_OVERRIDES = true;"
        ]
      ]
    },
    "overrides-on-bad-path": {
      "replace": [
        [
