{
  "hook": "remind-worktree-overrides.js",
  "variants": {
    "always": {
      "replace": [
        [
          "const ALWAYS_REMIND = '';",
          "const ALWAYS_REMIND = '先確認埠號指向這個工作樹的服務、建置後有重啟。';"
        ]
      ]
    },
    "portcheck": {
      "replace": [
        [
          "const PORT_CHECK_CMD = '';",
          "const PORT_CHECK_CMD = 'node .claude/hooks/check-worktree-ports.js --ports <服務>[@<工作樹>]=<port>,...';"
        ]
      ]
    }
  },
  "cases": [
    {
      "label": "從工作樹起服務、覆寫沒帶（cd 相對路徑）→ 提醒，模型看得到",
      "setup": {
        "files": {
          ".claude/local-overrides.yml": "app:\n  repo: .\n  files:\n    - path: config/local.json\n      reason: 本機連線指向本機資料庫\n",
          "config/local.json": "{\"db\":\"shared\"}\n",
          "src/main.js": "start();\n"
        },
        "commit": true,
        "files_after_commit": {
          "config/local.json": "{\"db\":\"local\"}\n"
        },
        "worktrees": {
          "wt/feat": "."
        }
      },
      "payload": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "cd wt/feat && npm run dev"
        }
      },
      "expect": "NOTE",
      "visible": true
    },
    {
      "label": "工作樹已帶覆寫 → 安靜",
      "setup": {
        "files": {
          ".claude/local-overrides.yml": "app:\n  repo: .\n  files:\n    - path: config/local.json\n      reason: 本機連線指向本機資料庫\n",
          "config/local.json": "{\"db\":\"shared\"}\n",
          "src/main.js": "start();\n"
        },
        "commit": true,
        "files_after_commit": {
          "config/local.json": "{\"db\":\"local\"}\n"
        },
        "worktrees": {
          "wt/feat": "."
        },
        "files_after_worktrees": {
          "wt/feat/config/local.json": "{\"db\":\"local\"}\n"
        }
      },
      "payload": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "cd wt/feat && npm run dev"
        }
      },
      "expect": "SILENT"
    },
