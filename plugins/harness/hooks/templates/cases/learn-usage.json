{
  "hook": "learn-usage.js",
  "cases": [
    {
      "label": "Read memory 目錄的 .md → view +1（debug 印計數）",
      "setup": {
        "files": {
          "mem/MEMORY.md": "# Memory Index\n- ⭐ [x](db-login.md) — x\n",
          "mem/db-login.md": "---\nname: db-login\n---\n"
        },
        "env": {
          "HARNESS_MEMORY_DIR": "{PROJECT_DIR}/mem",
          "HARNESS_LEARN_DEBUG": "1",
          "HARNESS_LEARN_CHILD": null,
          "COMPACT_HANDOFF_CHILD": null
        }
      },
      "payload": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Read",
        "tool_input": {
          "file_path": "{PROJECT_DIR}/mem/db-login.md"
        }
      },
      "expect": "NOTE"
    },
