          "HARNESS_MEMORY_DIR": "{PROJECT_DIR}/mem",
          "HARNESS_LEARN_DEBUG": "1",
          "HARNESS_LEARN_CHILD": null,
          "COMPACT_HANDOFF_CHILD": null
        }
      },
      "payload": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Read",
        "tool_input": {
          "file_path": "{PROJECT_DIR}/mem/db-login.md"
        }
      },
      "expect": "NOTE"
