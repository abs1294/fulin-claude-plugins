          "command": "head -n 5 {PROJECT_DIR_POSIX}/mem/db-login.md {PROJECT_DIR_POSIX}/mem/other.md {PROJECT_DIR_POSIX}/mem/db-login.md"
        }
      },
      "expect": "NOTE",
      "output_match": "view memory:db-login\\.md = 1[\\s\\S]*view memory:other\\.md = 1",
      "output_not_match": "= 2"
