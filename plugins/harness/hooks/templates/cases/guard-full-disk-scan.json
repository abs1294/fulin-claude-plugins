{
  "hook": "guard-full-disk-scan.js",
  "variants": {
    "project-at-drive-root": {
      "replace": [
        [
          "const PROJECT_ROOT = path.resolve(__dirname, '..', '..');",
          "const PROJECT_ROOT = path.parse(path.resolve(__dirname)).root;"
        ]
      ]
    },
    "project-at-drive-root-off": {
      "replace": [
        [
          "const PROJECT_ROOT = path.resolve(__dirname, '..', '..');",
          "const PROJECT_ROOT = path.parse(path.resolve(__dirname)).root;"
        ],
        [
          "const ALLOW_PROJECT_ROOT = true;",
          "const ALLOW_PROJECT_ROOT = false;"
        ]
      ]
    },
    "scope-project": {
      "replace": [
        [
          "const SCOPE = 'roots';",
          "const SCOPE = 'project';"
        ]
      ]
    },
    "scope-project-allowed": {
      "replace": [
        [
          "const SCOPE = 'roots';",
          "const SCOPE = 'project';"
        ],
        [
          "const ALLOWED_OUTSIDE = [];",
          "const ALLOWED_OUTSIDE = [path.join(os.homedir(), 'shared-data')];"
        ]
      ]
    },
    "extra-protected": {
      "replace": [
        [
          "const EXTRA_PROTECTED = [];",
          "const EXTRA_PROTECTED = [path.join(os.homedir(), 'big-share')];"
        ]
      ]
    },
    "exempt-root": {
      "replace": [
        [
          "const EXEMPT_ROOTS = [];",
          "const EXEMPT_ROOTS = [path.parse(path.resolve(__dirname)).root];"
        ]
      ]
    },
    "shallow-0": {
      "replace": [
        [
          "const SHALLOW = 2;",
          "const SHALLOW = 0;"
        ]
      ]
    },
    "no-shell-model": {
      "replace": [
        [
          "require('./shell-model.js')",
          "require('./shell-model-not-installed.js')"
        ]
      ]
    },
    "throw": {
      "replace": [
        [
          "function classify(raw, dir) {",
          "function classify(raw, dir) { throw new Error('probe-injected-failure');"
        ]
      ]
    }
  },
